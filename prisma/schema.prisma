// ============================================================
// Prisma Schema — CDN Fire Engineering Inventory & ERP System
// Database: Neon PostgreSQL
// Auth:     Better Auth v1.6.25
// ORM:      Prisma v7
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums — Auth & System
// ============================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

// ============================================================
// Enums — Inventory Module
// ============================================================

/// Goods receive transaction lifecycle states.
enum StockReceiveStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// Direction and reason for every inventory movement.
enum MovementType {
  IN
  OUT
  RETURN
  TRANSFER
  ADJUSTMENT
}

/// Source document that triggered a stock movement.
enum ReferenceType {
  STOCK_RECEIVE
  PROJECT
  PIPE_CUT
  RETURN
  MANUAL
}

/// Pipe cut piece lifecycle states.
enum PipeCutStatus {
  AVAILABLE
  USED
  SCRAPPED
}

// ============================================================
// Enums — Tools
// ============================================================

enum ToolCondition {
  New
  Good
  Fair
  Damaged
  UnderRepair
}

enum ToolStatus {
  Available
  InUse
  Maintenance
  Lost
  Retired
}

// ============================================================
// Better Auth Core Models
// ============================================================

/// Represents an authenticated user account in the system.
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  password      String?
  role          Role     @default(USER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sessions       Session[]
  accounts       Account[]
  auditLogs      AuditLog[]
  stockReceives  StockReceive[]  @relation("ReceivedByUser")
  stockMovements StockMovement[] @relation("CreatedByUser")

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("user")
}

/// Represents an active authentication session.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("session")
}

/// OAuth / credential accounts linked to a user.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

/// Email/phone verification tokens.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// Application-Specific Models
// ============================================================

/// Immutable audit trail for authentication and system events.
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  // Relations
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

// ============================================================
// Inventory Classification Models
// ============================================================

/// Top-level product/equipment category (e.g. Pipes, Sprinklers, Valves).
model Category {
  id           Int         @id @default(autoincrement())
  categoryName String      @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  subCategories SubCategory[]
  inventories   Inventory[]

  @@index([categoryName])
  @@map("category")
}

/// Sub-category belonging to a parent Category.
/// The (categoryId, name) composite is unique — the same name is allowed
/// across different categories but not within the same one.
model SubCategory {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id])
  inventories Inventory[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("sub_category")
}

// ============================================================
// Supplier Model
// ============================================================

/// Vendor/supplier master record.
model Supplier {
  id            Int      @id @default(autoincrement())
  company       String   @unique
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  stockReceives StockReceive[]

  @@index([company])
  @@map("supplier")
}

// ============================================================
// Inventory Master Model
// ============================================================

/// Master item catalogue. Current stock is NEVER stored here.
/// Compute it as: SUM(StockBatch.availableQty) WHERE inventoryId = this.id
model Inventory {
  id            Int      @id @default(autoincrement())
  itemCode      String   @unique
  name          String
  brand         String?
  unit          String
  minStock      Float    @default(0)
  barcode       String?  @unique
  rackLocation  String?
  warehouse     String?
  defaultSellPrice Float @default(0)
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Foreign keys
  categoryId    Int
  subCategoryId Int

  // Relations
  category       Category         @relation(fields: [categoryId], references: [id])
  subCategory    SubCategory      @relation(fields: [subCategoryId], references: [id])
  stockReceiveItems StockReceiveItem[]
  stockBatches   StockBatch[]
  stockMovements StockMovement[]
  pipeCutPieces  PipeCutPiece[]

  @@index([itemCode])
  @@index([barcode])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([name])
  @@map("inventory")
}

// ============================================================
// Goods Receive Models
// ============================================================

/// Header record for one goods receive transaction.
/// StockBatch records are NOT created until status → CONFIRMED.
model StockReceive {
  id          Int                @id @default(autoincrement())
  receiveNo   String             @unique
  receiveDate DateTime
  referenceNo String?
  remarks     String?
  status      StockReceiveStatus @default(DRAFT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Foreign keys
  supplierId  Int
  receivedBy  String             // references User.id

  // Relations
  supplier    Supplier           @relation(fields: [supplierId], references: [id])
  receivedByUser User            @relation("ReceivedByUser", fields: [receivedBy], references: [id])
  items       StockReceiveItem[]

  @@index([supplierId])
  @@index([receiveDate])
  @@index([status])
  @@map("stock_receive")
}

/// Line item within a goods receive document.
/// When the parent StockReceive is CONFIRMED, trigger creation of StockBatch.
model StockReceiveItem {
  id         Int       @id @default(autoincrement())
  qty        Float
  unitCost   Float
  batchNo    String?
  expiryDate DateTime?

  // Foreign keys
  stockReceiveId Int
  inventoryId    Int

  // Relations
  stockReceive StockReceive @relation(fields: [stockReceiveId], references: [id], onDelete: Cascade)
  inventory    Inventory    @relation(fields: [inventoryId], references: [id])
  stockBatch   StockBatch?

  @@index([stockReceiveId])
  @@index([inventoryId])
  @@map("stock_receive_item")
}

// ============================================================
// Stock Batch Model  (FIFO layer)
// ============================================================

/// Represents one received batch — the unit of FIFO consumption.
/// availableQty decreases as stock is issued; it must never go below 0.
model StockBatch {
  id           Int      @id @default(autoincrement())
  batchNo      String?
  receivedQty  Float
  availableQty Float
  unitCost     Float
  expiryDate   DateTime?
  receiveDate  DateTime
  rackLocation String?
  warehouse    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Foreign keys
  inventoryId        Int
  stockReceiveItemId Int @unique     // 1-to-1: one batch per receive line

  // Relations
  inventory        Inventory        @relation(fields: [inventoryId], references: [id])
  stockReceiveItem StockReceiveItem @relation(fields: [stockReceiveItemId], references: [id])
  stockMovements   StockMovement[]
  pipeCutPieces    PipeCutPiece[]

  @@index([inventoryId])
  @@index([batchNo])
  @@index([receiveDate])
  @@map("stock_batch")
}

// ============================================================
// Stock Movement Model  (audit / ledger)
// ============================================================

/// Immutable inventory ledger.
/// Every stock transaction — receive, issue, return, adjustment,
/// pipe cut — appends one record here.  Never delete rows.
model StockMovement {
  id            Int           @id @default(autoincrement())
  qty           Float
  movementType  MovementType
  referenceType ReferenceType
  referenceId   Int?          // polymorphic FK: ID of the source document
  remarks       String?
  createdAt     DateTime      @default(now())

  // Foreign keys
  inventoryId  Int
  stockBatchId Int
  createdBy    String         // references User.id

  // Relations
  inventory  Inventory  @relation(fields: [inventoryId], references: [id])
  stockBatch StockBatch @relation(fields: [stockBatchId], references: [id])
  createdByUser User    @relation("CreatedByUser", fields: [createdBy], references: [id])

  @@index([inventoryId])
  @@index([stockBatchId])
  @@index([movementType])
  @@index([referenceType])
  @@index([createdBy])
  @@index([createdAt])
  @@map("stock_movement")
}

// ============================================================
// Pipe Cut Piece Model
// ============================================================

/// Tracks remaining pipe off-cuts after a project cut.
/// Each piece is traceable back to its original batch (FIFO chain).
model PipeCutPiece {
  id           Int           @id @default(autoincrement())
  parentLength Float         // original full pipe length (metres / feet per unit)
  pieceLength  Float         // remaining cut piece length
  unit         String
  barcode      String?       @unique
  rackLocation String?
  status       PipeCutStatus @default(AVAILABLE)
  remarks      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Foreign keys
  inventoryId  Int
  stockBatchId Int

  // Relations
  inventory  Inventory  @relation(fields: [inventoryId], references: [id])
  stockBatch StockBatch @relation(fields: [stockBatchId], references: [id])

  @@index([inventoryId])
  @@index([stockBatchId])
  @@index([barcode])
  @@index([status])
  @@map("pipe_cut_piece")
}

// ============================================================
// Tool Model
// ============================================================

/// Physical tools/equipment tracked separately from consumable inventory.
model Tool {
  id        Int           @id @default(autoincrement())
  toolCode  String        @unique
  name      String
  serialNo  String        @unique
  condition ToolCondition
  status    ToolStatus
  imageUrl  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([toolCode])
  @@index([name])
  @@index([serialNo])
  @@index([status])
  @@map("tool")
}

// ============================================================
// Customer Model
// ============================================================

/// Customer/client master record.
model Customer {
  id            Int      @id @default(autoincrement())
  companyName   String   @unique
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyName])
  @@index([contactPerson])
  @@index([phone])
  @@index([email])
  @@map("customer")
}
