// ============================================================
// Prisma Schema — CDN Fire Engineering Inventory & ERP System
// Database: Neon PostgreSQL
// Auth:     Better Auth v1.6.25
// ORM:      Prisma v7
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums — Auth & System
// ============================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  GENERAL_MANAGER
  PROJECT_MANAGER
  ENGINEER
  ACCOUNTANT
  USER
}

// ============================================================
// Enums — Inventory Module
// ============================================================

/// Goods receive transaction lifecycle states.
enum StockReceiveStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// Direction and reason for every inventory movement.
enum MovementType {
  IN
  OUT
  RETURN
  TRANSFER
  ADJUSTMENT
}

/// Source document that triggered a stock movement.
enum ReferenceType {
  STOCK_RECEIVE
  PROJECT
  PIPE_CUT
  RETURN
  MANUAL
  PROJECT_TRANSFER
  DELIVERY_NOTE
  FIRE_EXTINGUISHER_REFILL
  FIRE_EXTINGUISHER_RETURN
  CUSTOMER_REFILL_TEMPORARY_REPLACEMENT
  CUSTOMER_REFILL_TEMPORARY_REPLACEMENT_RETURN
}

// ============================================================
// Enums — Fire Extinguisher Management Module
// ============================================================

enum FireExtinguisherUnitStatus {
  AVAILABLE
  ASSIGNED
  UNDER_REFILL
  TEMPORARY_REPLACEMENT
  DAMAGED
  LOST
  RETIRED
}

enum FireExtinguisherAssignmentStatus {
  ACTIVE
  RETURNED
  UNDER_REFILL
  REPLACED
  COMPLETED
}

enum DeliveryStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum RefillStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CustomerRefillStatus {
  DRAFT
  RECEIVED
  IN_PROGRESS
  READY_TO_RETURN
  COMPLETED
  CANCELLED
}

enum ReplacementStatus {
  ISSUED
  PARTIALLY_RETURNED
  RETURNED
}

/// Pipe cut piece lifecycle states.
enum PipeCutStatus {
  AVAILABLE
  USED
  SCRAPPED
}

// ============================================================
// Enums — Tools
// ============================================================

enum ToolCondition {
  New
  Good
  Fair
  Damaged
  UnderRepair
}

enum ToolStatus {
  Available
  InUse
  Maintenance
  Lost
  Retired
}

/// Tool assignment batch lifecycle states.
enum ToolAssignmentStatus {
  ACTIVE
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
}

/// Immutable tool event log action types.
enum ToolHistoryAction {
  ASSIGNED
  RETURNED
  REPAIR
  LOST
  RETIRED
}

// ============================================================
// Better Auth Core Models
// ============================================================

/// Represents an authenticated user account in the system.
model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?
  password      String?
  role          Role    @default(USER)
  isActive      Boolean @default(true)

  // Employee / profile fields
  employeeCode String? @unique
  phone        String?
  designation  String?
  department   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions                  Session[]
  accounts                  Account[]
  auditLogs                 AuditLog[]
  stockReceives             StockReceive[]      @relation("ReceivedByUser")
  stockMovements            StockMovement[]     @relation("CreatedByUser")
  managedProjects           Project[]           @relation("ProjectManager")
  projectAssignmentsBy      ProjectAssignment[] @relation("AssignedByUser")
  pmAssignments             ProjectAssignment[] @relation("PMAssignments")
  assignedEngineers         ProjectEngineer[]   @relation("AssignedEngineers")
  engineerAssignmentsBy     ProjectEngineer[]   @relation("EngineerAssignedByUser")
  materialRequests          MaterialRequest[]   @relation("EngineerRequests")
  issuedMaterialIssues      MaterialIssue[]     @relation("IssuedByUser")
  processedMaterialReturns  MaterialReturn[]    @relation("EngineerReturns")
  createdProjectExpenses    ProjectExpense[]    @relation("ExpenseCreatedByUser")
  createdProjectTransports  ProjectTransport[]  @relation("TransportCreatedByUser")
  toolAssignmentsAsEngineer ToolAssignment[]    @relation("AssignedToEngineer")
  toolHistoriesCreated      ToolHistory[]       @relation("ToolHistoryCreatedBy")
  labourAssignments         ProjectLabour[]     @relation("LabourAssignedByUser")
  otCreated                 LabourOT[]          @relation("OTCreatedByUser")
  staffAssignments          ProjectStaff[]      @relation("StaffAssignments")
  transfersRequested        ProjectTransfer[]   @relation("TransferRequestedBy")
  transfersApproved         ProjectTransfer[]   @relation("TransferApprovedBy")
  deliveryNotesCreated      DeliveryNote[]      @relation("DeliveryNoteCreatedBy")
  createdCustomerRefills    CustomerRefill[]    @relation("CustomerRefillCreatedBy")

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([employeeCode])
  @@map("user")
}

/// Represents an active authentication session.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("session")
}

/// OAuth / credential accounts linked to a user.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

/// Email/phone verification tokens.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// Role & Permission Models (RBAC/PBAC)
// ============================================================

/// Granular system permission definition.
model Permission {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  name        String
  module      String
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
  @@map("permission")
}

/// Junction mapping system roles to granted permissions.
model RolePermission {
  id           Int  @id @default(autoincrement())
  role         Role
  permissionId Int

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@index([permissionId])
  @@map("role_permission")
}

// ============================================================
// Application-Specific Models
// ============================================================

/// Immutable audit trail for authentication and system events.
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  // Relations
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

// ============================================================
// Inventory Classification Models
// ============================================================

/// Top-level product/equipment category (e.g. Pipes, Sprinklers, Valves).
model Category {
  id           Int      @id @default(autoincrement())
  categoryName String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  subCategories SubCategory[]
  inventories   Inventory[]

  @@index([categoryName])
  @@map("category")
}

/// Sub-category belonging to a parent Category.
/// The (categoryId, name) composite is unique — the same name is allowed
/// across different categories but not within the same one.
model SubCategory {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id])
  inventories Inventory[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("sub_category")
}

// ============================================================
// Supplier Model
// ============================================================

/// Vendor/supplier master record.
model Supplier {
  id            Int      @id @default(autoincrement())
  company       String   @unique
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  stockReceives StockReceive[]

  @@index([company])
  @@map("supplier")
}

// ============================================================
// Inventory Master Model
// ============================================================

/// Master item catalogue. Current stock is NEVER stored here.
/// Compute it as: SUM(StockBatch.availableQty) WHERE inventoryId = this.id
model Inventory {
  id               Int      @id @default(autoincrement())
  itemCode         String   @unique
  name             String
  brand            String?
  unit             String
  minStock         Float    @default(0)
  barcode          String?  @unique
  rackLocation     String?
  warehouse        String?
  defaultSellPrice Float    @default(0)
  expiryControlled Boolean  @default(false)
  imageUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Foreign keys
  categoryId    Int
  subCategoryId Int

  // Relations
  category             Category              @relation(fields: [categoryId], references: [id])
  subCategory          SubCategory           @relation(fields: [subCategoryId], references: [id])
  stockReceiveItems    StockReceiveItem[]
  stockBatches         StockBatch[]
  stockMovements       StockMovement[]
  pipeCutPieces        PipeCutPiece[]
  materialRequestItems MaterialRequestItem[]
  materialIssueItems   MaterialIssueItem[]
  projectMaterials     ProjectMaterial[]
  materialReturnItems  MaterialReturnItem[]
  projectTransferItems ProjectTransferItem[]
  fireExtinguisherUnits      FireExtinguisherUnit[]
  customerRefillReplacements CustomerRefillReplacement[]

  @@index([itemCode])
  @@index([barcode])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([name])
  @@map("inventory")
}

// ============================================================
// Goods Receive Models
// ============================================================

/// Header record for one goods receive transaction.
/// StockBatch records are NOT created until status → CONFIRMED.
model StockReceive {
  id          Int                @id @default(autoincrement())
  receiveNo   String             @unique
  receiveDate DateTime
  referenceNo String?
  remarks     String?
  status      StockReceiveStatus @default(DRAFT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Foreign keys
  supplierId Int
  receivedBy String // references User.id

  // Relations
  supplier       Supplier           @relation(fields: [supplierId], references: [id])
  receivedByUser User               @relation("ReceivedByUser", fields: [receivedBy], references: [id])
  items          StockReceiveItem[]

  @@index([supplierId])
  @@index([receiveDate])
  @@index([status])
  @@map("stock_receive")
}

/// Line item within a goods receive document.
/// When the parent StockReceive is CONFIRMED, trigger creation of StockBatch.
model StockReceiveItem {
  id         Int       @id @default(autoincrement())
  qty        Float
  unitCost        Float
  batchNo         String?
  manufactureDate DateTime?
  expiryDate      DateTime?

  // Foreign keys
  stockReceiveId Int
  inventoryId    Int

  // Relations
  stockReceive StockReceive @relation(fields: [stockReceiveId], references: [id], onDelete: Cascade)
  inventory    Inventory    @relation(fields: [inventoryId], references: [id])
  stockBatch   StockBatch?

  @@index([stockReceiveId])
  @@index([inventoryId])
  @@map("stock_receive_item")
}

// ============================================================
// Stock Batch Model  (FIFO layer)
// ============================================================

/// Represents one received batch — the unit of FIFO consumption.
/// availableQty decreases as stock is issued; it must never go below 0.
model StockBatch {
  id           Int       @id @default(autoincrement())
  batchNo      String?
  receivedQty  Float
  availableQty Float
  unitCost        Float
  manufactureDate DateTime?
  expiryDate      DateTime?
  receiveDate     DateTime
  rackLocation    String?
  warehouse       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Foreign keys
  inventoryId        Int
  stockReceiveItemId Int @unique // 1-to-1: one batch per receive line

  // Relations
  inventory            Inventory           @relation(fields: [inventoryId], references: [id])
  stockReceiveItem     StockReceiveItem    @relation(fields: [stockReceiveItemId], references: [id])
  stockMovements       StockMovement[]
  pipeCutPieces        PipeCutPiece[]
  materialIssueItems   MaterialIssueItem[]
  projectTransferItems ProjectTransferItem[]

  @@index([inventoryId])
  @@index([batchNo])
  @@index([expiryDate])
  @@index([availableQty])
  @@index([receiveDate])
  @@map("stock_batch")
}

// ============================================================
// Stock Movement Model  (audit / ledger)
// ============================================================

/// Immutable inventory ledger.
/// Every stock transaction — receive, issue, return, adjustment,
/// pipe cut — appends one record here.  Never delete rows.
model StockMovement {
  id            Int           @id @default(autoincrement())
  qty           Float
  movementType  MovementType
  referenceType ReferenceType
  referenceId   Int? // polymorphic FK: ID of the source document
  remarks       String?
  createdAt     DateTime      @default(now())

  // Foreign keys
  inventoryId  Int
  stockBatchId Int
  createdBy    String // references User.id

  // Relations
  inventory     Inventory  @relation(fields: [inventoryId], references: [id])
  stockBatch    StockBatch @relation(fields: [stockBatchId], references: [id])
  createdByUser User       @relation("CreatedByUser", fields: [createdBy], references: [id])

  @@index([inventoryId])
  @@index([stockBatchId])
  @@index([movementType])
  @@index([referenceType])
  @@index([createdBy])
  @@index([createdAt])
  @@map("stock_movement")
}

// ============================================================
// Pipe Cut Piece Model
// ============================================================

/// Tracks remaining pipe off-cuts after a project cut.
/// Each piece is traceable back to its original batch (FIFO chain).
model PipeCutPiece {
  id           Int           @id @default(autoincrement())
  parentLength Float // original full pipe length (metres / feet per unit)
  pieceLength  Float // remaining cut piece length
  unit         String
  barcode      String?       @unique
  rackLocation String?
  status       PipeCutStatus @default(AVAILABLE)
  remarks      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Foreign keys
  inventoryId  Int
  stockBatchId Int
  projectId    Int?

  // Relations
  inventory            Inventory             @relation(fields: [inventoryId], references: [id])
  stockBatch           StockBatch            @relation(fields: [stockBatchId], references: [id])
  project              Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectTransferItems ProjectTransferItem[]

  @@index([inventoryId])
  @@index([stockBatchId])
  @@index([projectId])
  @@index([barcode])
  @@index([status])
  @@map("pipe_cut_piece")
}

// ============================================================
// Tool Model
// ============================================================

/// Physical tools/equipment tracked separately from consumable inventory.
model Tool {
  id        Int           @id @default(autoincrement())
  toolCode  String        @unique
  name      String
  serialNo  String        @unique
  condition ToolCondition
  status    ToolStatus
  imageUrl  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  assignmentItems     ToolAssignmentItem[]
  histories            ToolHistory[]
  projectTransferItems ProjectTransferItem[]

  @@index([toolCode])
  @@index([name])
  @@index([serialNo])
  @@index([status])
  @@map("tool")
}

// ============================================================
// Customer Model
// ============================================================

/// Customer/client master record.
model Customer {
  id            Int      @id @default(autoincrement())
  companyName   String   @unique
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  projects                    Project[]
  fireExtinguisherAssignments FireExtinguisherAssignment[]
  deliveryNotes               DeliveryNote[]
  customerRefills             CustomerRefill[]  @relation("CustomerRefillForCustomer")

  @@index([companyName])
  @@index([contactPerson])
  @@index([phone])
  @@index([email])
  @@map("customer")
}

// ============================================================
// Enums — Project Management Module
// ============================================================

/// Classifies whether a project is a government or private sector contract.
enum ProjectType {
  GOVERNMENT
  PRIVATE
}

enum ProjectStatus {
  PENDING
  MATERIAL_REQUEST
  MATERIAL_APPROVED
  MATERIAL_ISSUED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaterialRequestStatus {
  PENDING
  PENDING_GM
  PENDING_ADMIN
  APPROVED
  REJECTED
  PARTIAL
  ISSUED
}

enum ReturnCondition {
  GOOD
  DAMAGED
  SCRAP
}

enum ProjectTransferStatus {
  DRAFT
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum ExpenseType {
  MATERIAL
  LABOUR
  TRANSPORT
  EQUIPMENT
  OTHER
}

enum TransportStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

/// Lifecycle state of a manually-entered project expense.
/// APPROVED  — expense is live in the ledger and counts toward actual cost.
/// PENDING_APPROVAL — actual cost would reach/exceed LKR 5 M; awaiting Super Admin.
/// REJECTED  — Super Admin declined; expense is not counted.
enum ExpenseApprovalStatus {
  APPROVED
  PENDING_APPROVAL
  REJECTED
}

// ============================================================
// Enums — Labour Management Module
// ============================================================

/// Lifecycle state of a labour assignment to a project.
enum LabourReleaseStatus {
  ACTIVE
  RELEASED
  ON_LEAVE
}

/// Role of an internal staff member (User) on a project.
enum ProjectStaffRole {
  PROJECT_MANAGER
  ENGINEER
}

/// Active / released lifecycle for an internal staff assignment.
enum ProjectStaffStatus {
  ACTIVE
  RELEASED
}

// ============================================================
// Project Management Models
// ============================================================

model Project {
  id               Int           @id @default(autoincrement())
  projectCode      String        @unique
  projectName      String
  customerId       Int
  projectManagerId String
  location         String?
  startDate        DateTime?
  endDate          DateTime?
  status           ProjectStatus @default(PENDING)
  projectType      ProjectType   @default(PRIVATE)
  description      String?

  // Project Value (Contract Value / Customer Price)
  projectValue Float @default(0)

  // Estimated Costs
  estimatedMaterialCost  Float @default(0)
  estimatedLabourCost    Float @default(0)
  estimatedTransportCost Float @default(0)
  estimatedEquipmentCost Float @default(0)
  estimatedOtherCost     Float @default(0)
  estimatedTotalCost     Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer         Customer            @relation(fields: [customerId], references: [id])
  projectManager   User                @relation("ProjectManager", fields: [projectManagerId], references: [id])
  assignments      ProjectAssignment[]
  engineers        ProjectEngineer[]
  materialRequests MaterialRequest[]
  projectMaterials ProjectMaterial[]
  materialReturns  MaterialReturn[]
  transports       ProjectTransport[]
  expenses         ProjectExpense[]
  toolAssignments  ToolAssignment[]
  toolHistories    ToolHistory[]
  projectLabours   ProjectLabour[]
  staffAssignments ProjectStaff[]
  transfersFrom               ProjectTransfer[]            @relation("ProjectTransferFrom")
  transfersTo                 ProjectTransfer[]            @relation("ProjectTransferTo")
  pipeCutPieces               PipeCutPiece[]
  fireExtinguisherAssignments FireExtinguisherAssignment[]

  @@index([projectCode])
  @@index([customerId])
  @@index([projectManagerId])
  @@index([status])
  @@index([projectType])
  @@map("project")
}

model ProjectAssignment {
  id               Int      @id @default(autoincrement())
  projectId        Int
  projectManagerId String
  assignedDate     DateTime @default(now())
  assignedBy       String

  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectManager User    @relation("PMAssignments", fields: [projectManagerId], references: [id])
  assignedByUser User    @relation("AssignedByUser", fields: [assignedBy], references: [id])

  @@index([projectId])
  @@index([projectManagerId])
  @@index([assignedBy])
  @@map("project_assignment")
}

model ProjectEngineer {
  id           Int      @id @default(autoincrement())
  projectId    Int
  engineerId   String
  isLead       Boolean  @default(false)
  assignedDate DateTime @default(now())
  assignedBy   String

  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  engineer       User    @relation("AssignedEngineers", fields: [engineerId], references: [id])
  assignedByUser User    @relation("EngineerAssignedByUser", fields: [assignedBy], references: [id])

  @@unique([projectId, engineerId])
  @@index([projectId])
  @@index([engineerId])
  @@index([assignedBy])
  @@map("project_engineer")
}

model ProjectExpense {
  id             Int                  @id @default(autoincrement())
  expenseNo      String               @unique
  projectId      Int
  expenseType    ExpenseType
  amount         Float
  expenseDate    DateTime             @default(now())
  description    String?
  referenceNo    String?
  createdBy      String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  /// Approval gate: auto-approved unless actual cost reaches LKR 5 M threshold.
  approvalStatus ExpenseApprovalStatus @default(APPROVED)
  approvedBy     String?              // references User.id — set on APPROVED or REJECTED
  approvedAt     DateTime?            // timestamp of the Super Admin decision
  approvalNote   String?              // optional rejection reason

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser User    @relation("ExpenseCreatedByUser", fields: [createdBy], references: [id])

  @@index([expenseNo])
  @@index([projectId])
  @@index([expenseType])
  @@index([expenseDate])
  @@index([approvalStatus])
  @@map("project_expense")
}

model ProjectTransport {
  id               Int             @id @default(autoincrement())
  transportNo      String          @unique
  projectId        Int
  transportDate    DateTime        @default(now())
  vehicleNumber    String
  driverName       String
  transportCompany String?
  fromLocation     String
  toLocation       String
  fuelCost         Float           @default(0)
  vehicleHireCost  Float           @default(0)
  loadingCost      Float           @default(0)
  unloadingCost    Float           @default(0)
  otherCost        Float           @default(0)
  totalCost        Float           @default(0)
  remarks          String?
  status           TransportStatus @default(DELIVERED)
  createdBy        String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser User    @relation("TransportCreatedByUser", fields: [createdBy], references: [id])

  @@index([transportNo])
  @@index([projectId])
  @@index([transportDate])
  @@index([status])
  @@map("project_transport")
}

model MaterialRequest {
  id          Int                   @id @default(autoincrement())
  requestNo   String                @unique
  projectId   Int
  engineerId  String
  requestDate DateTime              @default(now())
  status      MaterialRequestStatus @default(PENDING_GM)
  remarks     String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  project  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  engineer User                  @relation("EngineerRequests", fields: [engineerId], references: [id])
  items    MaterialRequestItem[]
  issues   MaterialIssue[]

  @@index([requestNo])
  @@index([projectId])
  @@index([engineerId])
  @@index([status])
  @@map("material_request")
}

model MaterialRequestItem {
  id                Int   @id @default(autoincrement())
  materialRequestId Int
  inventoryId       Int
  qtyRequested      Float
  qtyApproved       Float @default(0)
  qtyIssued         Float @default(0)

  materialRequest MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  inventory       Inventory       @relation(fields: [inventoryId], references: [id])

  @@index([materialRequestId])
  @@index([inventoryId])
  @@map("material_request_item")
}

model MaterialIssue {
  id                Int      @id @default(autoincrement())
  issueNo           String   @unique
  materialRequestId Int
  warehouse         String?
  issuedBy          String
  issueDate         DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  materialRequest MaterialRequest     @relation(fields: [materialRequestId], references: [id])
  issuedByUser    User                @relation("IssuedByUser", fields: [issuedBy], references: [id])
  items           MaterialIssueItem[]

  @@index([issueNo])
  @@index([materialRequestId])
  @@index([issuedBy])
  @@map("material_issue")
}

model MaterialIssueItem {
  id              Int   @id @default(autoincrement())
  materialIssueId Int
  stockBatchId    Int
  inventoryId     Int
  qty             Float
  costPrice       Float

  materialIssue    MaterialIssue     @relation(fields: [materialIssueId], references: [id], onDelete: Cascade)
  stockBatch       StockBatch        @relation(fields: [stockBatchId], references: [id])
  inventory        Inventory         @relation(fields: [inventoryId], references: [id])
  projectMaterials ProjectMaterial[]

  @@index([materialIssueId])
  @@index([stockBatchId])
  @@index([inventoryId])
  @@map("material_issue_item")
}

model ProjectMaterial {
  id                  Int      @id @default(autoincrement())
  projectId           Int
  inventoryId         Int
  materialIssueItemId Int
  issuedQty           Float
  returnedQty         Float    @default(0)
  balanceQty          Float
  status              String   @default("ASSIGNED") // ASSIGNED, PARTIALLY_RETURNED, FULLY_RETURNED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inventory         Inventory            @relation(fields: [inventoryId], references: [id])
  materialIssueItem MaterialIssueItem    @relation(fields: [materialIssueItemId], references: [id])
  returnItems       MaterialReturnItem[]

  @@index([projectId])
  @@index([inventoryId])
  @@index([materialIssueItemId])
  @@index([status])
  @@map("project_material")
}

model MaterialReturn {
  id           Int      @id @default(autoincrement())
  returnNo     String   @unique
  projectId    Int
  engineerId   String
  returnedDate DateTime @default(now())
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  engineer User                 @relation("EngineerReturns", fields: [engineerId], references: [id])
  items    MaterialReturnItem[]

  @@index([returnNo])
  @@index([projectId])
  @@index([engineerId])
  @@map("material_return")
}

model MaterialReturnItem {
  id                Int             @id @default(autoincrement())
  materialReturnId  Int
  projectMaterialId Int?
  inventoryId       Int
  qtyReturned       Float
  condition         ReturnCondition @default(GOOD)

  materialReturn  MaterialReturn   @relation(fields: [materialReturnId], references: [id], onDelete: Cascade)
  projectMaterial ProjectMaterial? @relation(fields: [projectMaterialId], references: [id])
  inventory       Inventory        @relation(fields: [inventoryId], references: [id])

  @@index([materialReturnId])
  @@index([projectMaterialId])
  @@index([inventoryId])
  @@map("material_return_item")
}

// ============================================================
// Tool Assignment Models
// ============================================================

/// Header record for a batch tool assignment to a project.
/// One assignment can include multiple tools.
model ToolAssignment {
  id                 Int                  @id @default(autoincrement())
  assignmentNo       String               @unique
  projectId          Int
  engineerId         String
  assignDate         DateTime             @default(now())
  expectedReturnDate DateTime?
  remarks            String?
  status             ToolAssignmentStatus @default(ACTIVE)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  // Relations
  project  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  engineer User                 @relation("AssignedToEngineer", fields: [engineerId], references: [id])
  items    ToolAssignmentItem[]

  @@index([projectId])
  @@index([engineerId])
  @@index([status])
  @@index([assignDate])
  @@map("tool_assignment")
}

/// One tool within a tool assignment batch.
model ToolAssignmentItem {
  id               Int            @id @default(autoincrement())
  toolAssignmentId Int
  toolId           Int
  conditionAtIssue ToolCondition
  returnedAt       DateTime?
  returnCondition  ToolCondition?
  remarks          String?

  // Relations
  toolAssignment ToolAssignment @relation(fields: [toolAssignmentId], references: [id], onDelete: Cascade)
  tool           Tool           @relation(fields: [toolId], references: [id])

  @@index([toolAssignmentId])
  @@index([toolId])
  @@map("tool_assignment_item")
}

/// Immutable audit log for every tool lifecycle event.
model ToolHistory {
  id         Int               @id @default(autoincrement())
  toolId     Int
  projectId  Int?
  engineerId String?
  action     ToolHistoryAction
  remarks    String?
  createdBy  String
  createdAt  DateTime          @default(now())

  // Relations
  tool          Tool     @relation(fields: [toolId], references: [id])
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdByUser User     @relation("ToolHistoryCreatedBy", fields: [createdBy], references: [id])

  @@index([toolId])
  @@index([projectId])
  @@index([engineerId])
  @@index([action])
  @@index([createdAt])
  @@map("tool_history")
}

// ============================================================
// Labour Management Models
// ============================================================

/// Master table of labour categories / trade types.
/// Soft-deletable — never hard-deleted if referenced by Labour records.
model LabourType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  labours Labour[]

  @@index([name])
  @@index([isActive])
  @@map("labour_type")
}

/// Physical worker master record.
/// monthlySalary is reference/master info only — project cost is set per-assignment.
model Labour {
  id            Int      @id @default(autoincrement())
  labourCode    String   @unique
  name          String
  labourTypeId  Int
  nic           String?  @unique
  phone         String?
  monthlySalary Float    @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  labourType     LabourType      @relation(fields: [labourTypeId], references: [id])
  projectLabours ProjectLabour[]

  @@index([labourCode])
  @@index([labourTypeId])
  @@index([isActive])
  @@map("labour")
}

/// Junction table — a labour assigned to a specific project.
/// A labour must be RELEASED before being assigned to another project.
/// History is NEVER deleted — status changes only.
model ProjectLabour {
  id            Int                 @id @default(autoincrement())
  projectId     Int
  labourId      Int
  labourCost    Float               @default(0) // manually entered total project cost for this labour
  startDate     DateTime?
  endDate       DateTime?
  releaseStatus LabourReleaseStatus @default(ACTIVE)
  releasedAt    DateTime?
  remarks       String?
  assignedBy    String // references User.id
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  labour         Labour     @relation(fields: [labourId], references: [id])
  assignedByUser User       @relation("LabourAssignedByUser", fields: [assignedBy], references: [id])
  overtimes      LabourOT[]

  @@index([projectId, labourId])
  @@index([projectId])
  @@index([labourId])
  @@index([releaseStatus])
  @@map("project_labour")
}

/// Overtime records per project-labour assignment.
model LabourOT {
  id              Int      @id @default(autoincrement())
  projectLabourId Int
  otDate          DateTime
  otHours         Float
  otRatePerHour   Float
  otAmount        Float // server-computed: otHours × otRatePerHour
  remarks         String?
  createdBy       String // references User.id
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projectLabour ProjectLabour @relation(fields: [projectLabourId], references: [id], onDelete: Cascade)
  createdByUser User          @relation("OTCreatedByUser", fields: [createdBy], references: [id])

  @@index([projectLabourId])
  @@index([otDate])
  @@map("labour_ot")
}

// ============================================================
// Internal Staff Assignment Model (User → Project)
// ============================================================

/// Junction table linking internal Users (engineers/PMs) to a Project.
/// Tracks role, cost, and release status per assignment.
/// User details (name, email, role) come from the User relation — never duplicated here.
model ProjectStaff {
  id           Int               @id @default(autoincrement())
  projectId    Int
  userId       String            // references User.id
  role         ProjectStaffRole
  isLead       Boolean           @default(false)
  assignedDate DateTime          @default(now())
  releasedDate DateTime?
  status       ProjectStaffStatus @default(ACTIVE)
  salaryCost   Float             @default(0)
  otHours      Float             @default(0)
  otCost       Float             @default(0)
  remarks      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("StaffAssignments", fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@map("project_staff")
}

// ============================================================
// Project Stock Transfer Models
// ============================================================

model ProjectTransfer {
  id            Int                   @id @default(autoincrement())
  transferNo    String                @unique
  fromProjectId Int
  toProjectId   Int
  transferDate  DateTime              @default(now())
  status        ProjectTransferStatus @default(DRAFT)
  requestedById String
  approvedById  String?
  remarks       String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  fromProject Project @relation("ProjectTransferFrom", fields: [fromProjectId], references: [id], onDelete: Restrict)
  toProject   Project @relation("ProjectTransferTo", fields: [toProjectId], references: [id], onDelete: Restrict)
  requestedBy User    @relation("TransferRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?   @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  items ProjectTransferItem[]

  @@index([fromProjectId])
  @@index([toProjectId])
  @@index([status])
  @@index([transferDate])
  @@map("project_transfer")
}

model ProjectTransferItem {
  id                Int   @id @default(autoincrement())
  projectTransferId Int
  inventoryId       Int?
  stockBatchId      Int?
  pipeCutPieceId    Int?
  toolId            Int?
  qty               Float @default(0)
  unit              String
  unitCost          Float @default(0)
  remarks           String?

  projectTransfer ProjectTransfer @relation(fields: [projectTransferId], references: [id], onDelete: Cascade)
  inventory       Inventory?      @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  stockBatch      StockBatch?     @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)
  pipeCutPiece    PipeCutPiece?   @relation(fields: [pipeCutPieceId], references: [id], onDelete: Restrict)
  tool            Tool?           @relation(fields: [toolId], references: [id], onDelete: Restrict)

  @@index([projectTransferId])
  @@index([inventoryId])
  @@index([stockBatchId])
  @@index([pipeCutPieceId])
  @@index([toolId])
  @@map("project_transfer_item")
}

// ============================================================
// Expiry & System Notification Models
// ============================================================

enum NotificationType {
  EXPIRY_7_DAYS
  EXPIRY_30_DAYS
  STOCK_EXPIRED
  INFO
  WARNING
  MATERIAL_REQUEST_SUBMITTED
  MATERIAL_REQUEST_CREATED         // Admin/Super-Admin alert — new request pending
  MATERIAL_REQUEST_APPROVED        // Requester alert — their request was approved
  MATERIAL_REQUEST_REJECTED        // Requester alert — their request was rejected
  COST_THRESHOLD_PENDING_APPROVAL  // Super-Admin alert — expense needs approval (cost ≥ 5 M)
  COST_THRESHOLD_APPROVED          // Requester alert — their high-cost expense was approved
  COST_THRESHOLD_REJECTED          // Requester alert — their high-cost expense was rejected
}

model Notification {
  id                Int              @id @default(autoincrement())
  type              NotificationType
  title             String
  message           String
  isRead            Boolean          @default(false)
  batchId           Int?             // used by expiry notifications
  materialRequestId Int?             // used by material request notifications
  userId            String?          // null = broadcast; non-null = targeted user
  createdAt         DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([materialRequestId])
  @@map("notification")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_setting")
}

// ============================================================
// Fire Extinguisher Management Models
// ============================================================

model FireExtinguisherUnit {
  id              Int                        @id @default(autoincrement())
  unitCode        String                     @unique
  inventoryId     Int
  status          FireExtinguisherUnitStatus @default(AVAILABLE)
  serialNumber    String?                    @unique
  manufactureDate DateTime?
  expiryDate      DateTime?
  notes           String?

  inventory                Inventory                    @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  assignments              FireExtinguisherAssignment[]
  refillRecords            ExtinguisherRefill[]         @relation("RefillOriginalUnit")
  replacementRefillRecords ExtinguisherRefill[]         @relation("RefillReplacementUnit")
  deliveryItems            DeliveryNoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inventoryId])
  @@index([status])
  @@index([unitCode])
  @@map("fire_extinguisher_unit")
}

model FireExtinguisherAssignment {
  id                     Int                              @id @default(autoincrement())
  fireExtinguisherUnitId Int
  projectId              Int?
  customerId             Int?
  assignedDate           DateTime                         @default(now())
  location               String?
  status                 FireExtinguisherAssignmentStatus @default(ACTIVE)
  returnedDate           DateTime?
  notes                  String?

  fireExtinguisherUnit FireExtinguisherUnit @relation(fields: [fireExtinguisherUnitId], references: [id], onDelete: Restrict)
  project              Project?             @relation(fields: [projectId], references: [id])
  customer             Customer?            @relation(fields: [customerId], references: [id])
  refills              ExtinguisherRefill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fireExtinguisherUnitId])
  @@index([projectId])
  @@index([customerId])
  @@index([status])
  @@map("fire_extinguisher_assignment")
}

model DeliveryNote {
  id              Int            @id @default(autoincrement())
  deliveryNo      String         @unique
  customerId      Int
  deliveryDate    DateTime       @default(now())
  deliveryAddress String?
  notes           String?
  status          DeliveryStatus @default(DRAFT)

  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items       DeliveryNoteItem[]
  createdById String?
  createdBy   User?              @relation("DeliveryNoteCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([deliveryDate])
  @@index([status])
  @@map("delivery_note")
}

model DeliveryNoteItem {
  id                     Int @id @default(autoincrement())
  deliveryNoteId         Int
  fireExtinguisherUnitId Int

  deliveryNote         DeliveryNote         @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  fireExtinguisherUnit FireExtinguisherUnit @relation(fields: [fireExtinguisherUnitId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([deliveryNoteId, fireExtinguisherUnitId])
  @@index([deliveryNoteId])
  @@index([fireExtinguisherUnitId])
  @@map("delivery_note_item")
}

model ExtinguisherRefill {
  id                           Int          @id @default(autoincrement())
  fireExtinguisherAssignmentId Int
  fireExtinguisherUnitId       Int
  receivedDate                 DateTime     @default(now())
  completedDate                DateTime?
  status                       RefillStatus @default(RECEIVED)
  replacementUnitId            Int?
  notes                        String?

  assignment           FireExtinguisherAssignment @relation(fields: [fireExtinguisherAssignmentId], references: [id], onDelete: Restrict)
  fireExtinguisherUnit FireExtinguisherUnit       @relation("RefillOriginalUnit", fields: [fireExtinguisherUnitId], references: [id], onDelete: Restrict)
  replacementUnit      FireExtinguisherUnit?      @relation("RefillReplacementUnit", fields: [replacementUnitId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fireExtinguisherAssignmentId])
  @@index([fireExtinguisherUnitId])
  @@index([replacementUnitId])
  @@index([status])
  @@map("extinguisher_refill")
}

// ============================================================
// Customer-Owned Fire Extinguisher Refill Models
// ============================================================

/// Refill job for customer-owned fire extinguishers.
/// Customer-owned items NEVER affect warehouse stock or Inventory.
model CustomerRefill {
  id            Int                  @id @default(autoincrement())
  refillNo      String               @unique
  customerId    Int
  receivedDate  DateTime             @default(now())
  completedDate DateTime?
  status        CustomerRefillStatus @default(DRAFT)
  notes         String?
  createdById   String?

  customer  Customer @relation("CustomerRefillForCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("CustomerRefillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items        CustomerRefillItem[]
  replacements CustomerRefillReplacement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([receivedDate])
  @@map("customer_refill")
}

/// Line items: customer-owned extinguishers received for refill.
/// These NEVER create StockMovement, StockBatch, Inventory, or Physical Unit records.
model CustomerRefillItem {
  id               Int    @id @default(autoincrement())
  customerRefillId Int
  extinguisherType String
  capacity         String?
  receivedQty      Float
  returnedQty      Float  @default(0)
  notes            String?

  customerRefill CustomerRefill @relation(fields: [customerRefillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerRefillId])
  @@map("customer_refill_item")
}

/// Temporary replacements issued from OUR warehouse while customer extinguishers are refilled.
/// Issue creates StockMovement OUT (CUSTOMER_REFILL_TEMPORARY_REPLACEMENT).
/// Return creates StockMovement IN (CUSTOMER_REFILL_TEMPORARY_REPLACEMENT_RETURN).
model CustomerRefillReplacement {
  id               Int               @id @default(autoincrement())
  customerRefillId Int
  inventoryId      Int
  issuedQty        Float
  returnedQty      Float             @default(0)
  status           ReplacementStatus @default(ISSUED)
  issuedDate       DateTime          @default(now())
  returnedDate     DateTime?
  notes            String?

  customerRefill CustomerRefill @relation(fields: [customerRefillId], references: [id], onDelete: Cascade)
  inventory      Inventory      @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerRefillId])
  @@index([inventoryId])
  @@index([status])
  @@map("customer_refill_replacement")
}
