// ============================================================
// Prisma Schema — CDN Fire Engineering Inventory & ERP System
// Database: Neon PostgreSQL
// Auth:     Better Auth v1.6.25
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

// ============================================================
// Better Auth Core Models
// ============================================================

/// Represents an authenticated user account in the system.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  password      String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  sessions  Session[]
  accounts  Account[]
  auditLogs AuditLog[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("user")
}

/// Represents an active authentication session.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("session")
}

/// OAuth / credential accounts linked to a user.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

/// Email/phone verification tokens.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// Application-Specific Models
// ============================================================

/// Immutable audit trail for authentication events.
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  // Relations
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

// ============================================================
// Inventory Classification Models
// ============================================================

/// Top-level product/equipment category.
model Category {
  id           Int           @id @default(autoincrement())
  categoryName String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  subCategories SubCategory[]
  inventories   Inventory[]

  @@index([categoryName])
  @@map("category")
}

/// Sub-category belonging to a parent Category.
/// (categoryId, name) must be unique — same name is allowed across different categories.
model SubCategory {
  id          Int         @id @default(autoincrement())
  name        String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id])
  inventories Inventory[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("sub_category")
}

// ============================================================
// Enums
// ============================================================

enum IssueLocation {
  Warehouse
  Shop
}

// ============================================================
// Supplier Model
// ============================================================

model Supplier {
  Id            Int         @id @default(autoincrement())
  Company       String      @unique
  ContactPerson String?
  Phone         String?
  Email         String?
  Address       String?

  inventories   Inventory[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([Company])
  @@map("supplier")
}

// ============================================================
// Inventory Management Model
// ============================================================

model Inventory {
  Id            Int           @id @default(autoincrement())
  ItemCode      String        @unique
  Name          String
  CategoryId    Int
  SubCategoryId Int
  Brand         String?
  Unit          String
  Qty           Float         @default(0)
  MinStock      Float         @default(0)
  RackLocation  String?
  Warehouse     String?
  BuyPrice      Float         @default(0)
  SellPrice     Float         @default(0)
  SupplierId    Int?
  Barcode       String?       @unique
  ExpiryDate    DateTime?
  image_url     String?
  issueLocation IssueLocation @default(Warehouse)

  // Relations
  category      Category      @relation(fields: [CategoryId], references: [id])
  subCategory   SubCategory   @relation(fields: [SubCategoryId], references: [id])
  supplier      Supplier?     @relation(fields: [SupplierId], references: [Id], onDelete: Restrict)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([ItemCode])
  @@index([Barcode])
  @@index([Name])
  @@index([CategoryId])
  @@index([SubCategoryId])
  @@map("inventory")
}

// ============================================================
// Tool Enums & Model
// ============================================================

enum ToolCondition {
  New
  Good
  Fair
  Damaged
  UnderRepair
}

enum ToolStatus {
  Available
  InUse
  Maintenance
  Lost
  Retired
}

model Tool {
  Id        Int           @id @default(autoincrement())
  ToolCode  String        @unique
  Name      String
  SerialNo  String        @unique
  Condition ToolCondition
  Status    ToolStatus
  image_url String?

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([ToolCode])
  @@index([Name])
  @@index([SerialNo])
  @@index([Status])
  @@map("tool")
}

// ============================================================
// Customer Model
// ============================================================

model Customer {
  Id            Int      @id @default(autoincrement())
  CompanyName   String   @unique
  ContactPerson String?
  Phone         String?
  Email         String?
  Address       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([CompanyName])
  @@index([ContactPerson])
  @@index([Phone])
  @@index([Email])
  @@map("customer")
}




